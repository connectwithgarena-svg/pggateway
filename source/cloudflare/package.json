{
  "name": "ffshop-cloudflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "typecheck": "tsc --noEmit",
